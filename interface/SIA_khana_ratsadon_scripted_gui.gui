guiTypes = {

	containerWindowType = {
		name = "sia_khana_ratsadon_ui_window"
		orientation = lower_left
		position = { x = 0 y = 0 }
		size = { width = 460 height = 370 }
		clipping = no

		background = {
			name = "sia_khana_ratsadon_background"
			quadTextureSprite = "GFX_tiled_plain_bg"
		}

		# Trait badge backgrounds — declared before text so they render beneath
		iconType = {
			name = "sia_khana_ratsadon_civilian_state_box"
			spriteType = "GFX_trait_box_fuhrer"
			position = { x = 115 y = 163 }
			centerposition = yes
			alwaystransparent = yes
		}

		iconType = {
			name = "sia_khana_ratsadon_military_state_box"
			spriteType = "GFX_trait_box_fuhrer"
			position = { x = 345 y = 163 }
			centerposition = yes
			alwaystransparent = yes
		}

		instantTextBoxType = {
			name = "sia_khana_ratsadon_title"
			position = { x = 0 y = 10 }
			format = center
			font = "hoi_36header"
			text = "SIA_khana_ratsadon_inlay_title"
			maxWidth = 460
			maxHeight = 40
		}

		# Civilian wing — left half centre ~115px
		iconType = {
			name = "civilian_wing_status"
			position = { x = 90 y = 55 }
