				position = { x = 10 y = 10 }
				format = center
				font = "hoi_16mbs"
				context_aware_text = [SIA_GetCivilianWingDesc]
				maxWidth = 175
				maxHeight = 145
			}
		}

		# Military wing — right half centre ~345px
		iconType = {
			name = "military_wing_status"
			position = { x = 320 y = 55 }
			spriteType = "GFX_idea_SIA_military_neutral"
			tooltip = "SIA_military_wing_history_tt"
		}

		instantTextBoxType = {
			name = "sia_khana_ratsadon_military_label"
			position = { x = 270 y = 130 }
			format = center
			font = "hoi_18"
			text = "SIA_military_wing_label"
			maxWidth = 150
			maxHeight = 22
		}

		instantTextBoxType = {
			name = "sia_khana_ratsadon_military_state"
